{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "openaq_reading_v3",
  "description": "v2 plus one optional field, sensor_grade (an additive change).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source",
    "station_id",
    "location_id",
    "sensors_id",
    "parameter",
    "value_raw",
    "unit",
    "datetime"
  ],
  "properties": {
    "schema_version": {
      "type": "integer"
    },
    "source": {
      "type": "string"
    },
    "station_id": {
      "type": "string"
    },
    "location_id": {
      "type": "integer"
    },
    "sensors_id": {
      "type": "integer"
    },
    "location_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "lat": {
      "type": [
        "number",
        "null"
      ]
    },
    "lon": {
      "type": [
        "number",
        "null"
      ]
    },
    "parameter": {
      "type": "string"
    },
    "parameter_raw": {
      "type": [
        "string",
        "null"
      ]
    },
    "value": {
      "type": [
        "number",
        "null"
      ]
    },
    "value_raw": {
      "type": [
        "string",
        "null"
      ]
    },
    "unit": {
      "type": [
        "string",
        "null"
      ]
    },
    "units_raw": {
      "type": [
        "string",
        "null"
      ]
    },
    "datetime": {
      "type": "string"
    },
    "datetime_local_raw": {
      "type": [
        "string",
        "null"
      ]
    },
    "ingested_at": {
      "type": "string"
    },
    "sensor_grade": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
